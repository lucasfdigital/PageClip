{
  "name": "hub-react",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:hub && npm run build:overlay && npm run build:site",
    "build:hub": "vite build",
    "build:overlay": "vite build -c vite.overlay.config.js",
    "build:site": "vite build -c vite.site.config.js && node scripts/prerender-site.js",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@remixicon/react": "^4.9.0",
    "@tailwindcss/postcss": "^4.3.3",
    "motion": "^14.0.0",
    "react": "^19.2.8",
    "react-aria-components": "^1.22.0",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.4"
  }
}
